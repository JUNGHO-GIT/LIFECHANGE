{
  "$schema": "http://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "out",
    "paths": {
			"@type/*": ["src/assets/type/domain/*"],
      "@assets/*": ["src/assets/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@repositories/*": ["src/repositories/*"],
      "@routers/*": ["src/routers/*"],
      "@schemas/*": ["src/schemas/*"],
      "@services/*": ["src/services/*"],
      "@exportLibs": ["src/exports/ExportLibs"],
      "@exportAssets": ["src/exports/ExportAssets"],
			"@exportRepositories": ["src/exports/ExportRepositories"],
			"@exportRouters": ["src/exports/ExportRouters"],
			"@exportSchemas": ["src/exports/ExportSchemas"],
			"@exportServices": ["src/exports/ExportServices"]
    },
    "typeRoots": [
			"src/assets/type/dist",
			"node_modules/@types"
    ],
		"types": [
			"node"
		]
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
		"src/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
		"eslint.config.js",
		"eslint.config.cjs",
		"eslint.config.mjs",
		"eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}