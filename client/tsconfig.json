{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "rootDirs": [],
    "outDir": "./out",
    "paths": {
      "@type/*": ["./src/assets/type/domain/*"],
      "@assets/*": ["./src/assets/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@stores/*": ["./src/stores/*"],
      "@pages/*": ["./src/pages/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@exportHooks": ["./src/exports/ExportHooks"],
      "@exportStores": ["./src/exports/ExportStores"],
      "@exportLibs": ["./src/exports/ExportLibs"],
      "@exportMuis": ["./src/exports/ExportMuis"],
      "@exportReacts": ["./src/exports/ExportReacts"],
      "@exportSchemas": ["./src/exports/ExportSchemas"],
      "@exportScripts": ["./src/exports/ExportScripts"],
      "@exportTypes": ["./src/exports/ExportTypes"],
      "@exportComponents": ["./src/exports/ExportComponents"],
      "@exportContainers": ["./src/exports/ExportContainers"],
      "@exportLayouts": ["./src/exports/ExportLayouts"],
      "@exportPages": ["./src/exports/ExportPages"]
    },
    "typeRoots": [
      "./src/assets/type/dist",
      "node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "composite": true,
    "incremental": true,
    "pretty": true,
    "diagnostics": false,
    "sourceMap": true,
    "mapRoot": "",
    "sourceRoot": "",
    "plugins": [],
    "removeComments": true,
    "newLine": "lf",
    "assumeChangesOnlyAffectDirectDependencies": false,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "traceResolution": false,
    "extendedDiagnostics": false,
    "explainFiles": false,
    "exactOptionalPropertyTypes": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "isolatedDeclarations": false,
    "stripInternal": false,
    "maxNodeModuleJsDepth": 0,
    "listFiles": false,
    "listEmittedFiles": false,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "",
    "esModuleInterop": true,
    "isolatedModules": false,
    "moduleDetection": "auto",
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "customConditions": [],
    "moduleSuffixes": [],
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noEmit": true,
    "noEmitOnError": true,
    "noLib": false,
    "noResolve": false,
    "noImplicitOverride": true,
    "noImplicitUseStrict": false,
    "noEmitHelpers": false,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "noStrictGenericChecks": false,
    "disableReferencedProjectLoad": false,
    "disableSolutionSearching": false,
    "disableSourceOfProjectReferenceRedirect": false,
    "disableSizeLimit": true,
    "preserveSymlinks": true,
    "preserveConstEnums": false,
    "preserveWatchOutput": false,
    "preserveValueImports": false,
    "emitBOM": false,
    "emitDeclarationOnly": false,
    "emitDecoratorMetadata": true,
    "alwaysStrict": true,
    "allowImportingTsExtensions": true,
    "allowUmdGlobalAccess": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "keyofStringsOnly": false,
    "suppressExcessPropertyErrors": false,
    "suppressImplicitAnyIndexErrors": false,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": false,
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "importHelpers": true,
    "importsNotUsedAsValues": "remove",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
    "./src/**/*",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
