/**
 * @file .client.swcrc
 * @description swc 설정 (클라이언트) - @swc/core v1.15.x 최신 공식 문서 기반
 * @author Jungho
 * @since 2025-11-30
 * @updated 2026-02-08
 * @see https://swc.rs/docs/configuration/compilation
 * @see https://swc.rs/docs/configuration/modules
 * @see https://swc.rs/docs/configuration/minification
 */
{
  // 0. common -----------------------------------------------------------------------------------------
  "$schema": "https://swc.rs/schema.json",
  "inlineSourcesContent": false, // 소스맵에 원본 소스 포함 여부 (기본값 true)
  "isModule": true, // 모듈 취급 여부 (true | false | 'unknown')
  "minify": true, // 프론트엔드 프로덕션 빌드 시 필수 활성화
  "sourceMaps": false, // 소스맵 생성 여부 (true | false | 'inline')
  "exclude": [], // 변환에서 제외할 패턴 배열 (정규식 문자열)
  // 1. module -----------------------------------------------------------------------------------------
  "module": {
    "type": "es6", // 모듈 타입 – 번들러 Tree-shaking 용
    "strict": true, // __esModule 호환성 강화 (기본값 false)
    "strictMode": true, // 'use strict' 디렉티브 출력 (기본값 true)
    "lazy": false, // lazy import 활성화 여부 (true | false | string[])
    "noInterop": false, // interop 헬퍼 비활성화 여부 (기본값 false)
    "importInterop": "swc", // CJS ↔ ESM interop 방식 ('swc' | 'node' | 'none')
    "ignoreDynamic": false, // 동적 import() 유지 여부 – 번들러 위임 시 false 유지
    "preserveImportMeta": false, // import.meta 유지 여부
    "resolveFully": false // 모듈 import 경로를 index.js 포함 완전 해석 여부
    // "outFileExtension": "js",      // resolveFully 와 함께 사용 – 출력 확장자 ('js' | 'cjs' | 'mjs')
  },
  // 2. jsc --------------------------------------------------------------------------------------------
  "jsc": {
    // 2-0. common -------------------------------------------------------------------------------------
    "baseUrl": "./", // paths 해석 기준 경로 (절대 경로 권장)
    "target": "es2022", // 모던 브라우저 타겟 (esnext 보다 안정적)
    "loose": true, // 전역 loose 모드 – 성능 유리하나 assumptions 주의
    "externalHelpers": false, // @swc/helpers 외부 모듈 사용 여부 (번들링 시 true 고려)
    "keepClassNames": false, // 클라이언트 번들 사이즈 절감을 위해 false 권장
    "preserveAllComments": false, // true 면 모든 주석 보존
    "paths": {}, // 모듈 alias 매핑 (tsconfig paths 와 동일)
    // 2-1. parser -------------------------------------------------------------------------------------
    "parser": {
      "syntax": "typescript", // 파서 문법 ('typescript' | 'ecmascript')
      "tsx": true, // TSX (JSX in TS) 사용 여부
      "decorators": true, // 데코레이터 문법 허용 여부
      "dynamicImport": true // import() 문법 허용 여부
    },
    // 2-2. minify -------------------------------------------------------------------------------------
    //       v1.11.11+ 에서 compress: true|{} 설정 시 모든 주석 자동 제거
    //       주석 보존이 필요하면 format.comments 설정 필요
    "minify": {
      "compress": {
        "unused": true, // 사용되지 않는 변수/함수 제거
        "dead_code": true, // 도달 불가(dead) 코드 제거
        "drop_console": true, // 프로덕션 빌드 시 console.* 제거
        "drop_debugger": true // debugger 구문 제거
      },
      "mangle": {
        "keep_classnames": false, // 난독화 시 클래스 이름 제거 (용량 감소)
        "keep_fnames": false // 난독화 시 함수 이름 제거 (용량 감소)
        // "properties": {            // 프로퍼티 난독화 (주의: 신중히 사용)
        //   "reserved": [],          // 난독화 제외 프로퍼티 목록
        //   "undeclared": false,     // 선언되지 않은 프로퍼티도 난독화 여부
        //   "regex": ""              // 난독화 대상 프로퍼티 필터 (Rust 정규식)
        // }
      }
      // "format": {                  // v1.11.11+ – 압축 시 주석 제어
      //   "comments": false,         // 'all' | 'some' | false
      //   "asciiOnly": false,        // v1.2.184+ – ASCII 전용 출력 여부
      //   "inlineScript": false      // v1.9.2+ – inline script 이스케이프 여부
      // }
    },
    // 2-3. transform ----------------------------------------------------------------------------------
    "transform": {
      "legacyDecorator": true, // MobX 등 레거시 데코레이터 호환 (stage 1)
      "decoratorMetadata": true, // 데코레이터 메타데이터 emit (Reflection)
      // "decoratorVersion": "2021-12",  // v1.3.47+ – stage 3 데코레이터 사용 시 "2022-03"
      "useDefineForClassFields": false, // false: 할당 방식 (호환성) / true: defineProperty 방식
      "treatConstEnumAsEnum": false, // const enum 인라인화 (false = 인라인, 용량 감소)
      "verbatimModuleSyntax": false, // import/export 문법 그대로 유지 여부
      // "tsEnumIsMutable": false,    // TS enum 을 수정 가능한 객체로 컴파일 여부
      "react": {
        "runtime": "automatic", // React 17+ 신규 런타임 ('automatic' | 'classic' | 'preserve')
        "useBuiltins": true, // Object.assign 등 내장 사용 여부
        "refresh": false // [주의] 프로덕션(minify:true) 에서는 반드시 false
        // "importSource": "react",   // automatic runtime 사용 시 jsx/jsxs import 소스
        // "pragma": "React.createElement",   // classic runtime 전용
        // "pragmaFrag": "React.Fragment",    // classic runtime 전용
        // "development": false,      // 개발 모드 – __self, __source 디버그 props 추가
        // "throwIfNamespace": true   // JSX namespace 태그 사용 시 에러 여부
      }
      // "constModules": {            // Ember 스타일 상수 모듈 치환
      //   "globals": {}
      // },
      // "optimizer": {               // 코드 최적화 패스
      //   "simplify": true,          // v1.2.101+ – 코드 단순화 최적화
      //   "globals": {
      //     "vars": {},              // 전역 상수 치환 매핑 (예: {"__DEBUG__": "true"})
      //     "typeofs": {},           // typeof 결과 치환 (예: {"window": "object"})
      //     "envs": ["NODE_ENV", "SWC_ENV"]  // inline-global 대상 환경 변수
      //   },
      //   "jsonify": {
      //     "minCost": 1024          // 순수 객체 리터럴 → JSON.parse 변환 최소 비용
      //   }
      // }
    },
    // 2-4. experimental -------------------------------------------------------------------------------
    // "experimental": {
    //   "keepImportAttributes": false,  // import attributes 유지 (ECMAScript 사양 미확정)
    //   "cacheRoot": "",               // SWC 캐시 경로 (미지정 시 .swc 디렉터리)
    //   "plugins": []                  // Wasm 기반 플러그인 목록 [["@swc/plugin-xxx", {}]]
    // },
    // 2-5. output -------------------------------------------------------------------------------------
    "output": {
      "charset": "utf8" // 출력 인코딩 ('utf8' | 'ascii')
    }
  }
  // 3. env --------------------------------------------------------------------------------------------
  // [주의] env 와 jsc.target 은 함께 사용 불가 – jsc.target 사용 시 env 전체 주석 처리
  // "env": {
  //   "targets": {},                 // browserslist 쿼리 또는 브라우저별 버전 매핑
  //   "mode": false,                 // polyfill 모드 ('usage' | 'entry' | false)
  //   "coreJs": "",                  // core-js 버전 (예: "3.36") – mode 와 함께 사용
  //   "debug": false,                // env 변환 디버그 로그 출력
  //   "dynamicImport": false,        // dynamic import 관련 transform
  //   "loose": false,                // env transform loose 모드
  //   "bugfixes": false,             // 최신 문법 버그 패치 transform
  //   "shippedProposals": false,     // 구현된 proposal 변환 여부
  //   "forceAllTransforms": false,   // 모든 transform 강제 적용
  //   "include": [],                 // 항상 포함할 transform 이름 목록
  //   "exclude": [],                 // 제외할 transform 이름 목록
  //   "skip": []                     // 특정 타깃에서만 건너뛸 transform
  // }
}
