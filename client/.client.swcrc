{
  "$schema": "https://swc.rs/schema.json",
  "isModule": "unknown",
  "minify": true,
  "sourceMaps": true,
  "inlineSourcesContent": false,
  "exclude": [
    "node_modules"
  ],
  "module": {
    "type": "es6",
    "strict": true,
    "strictMode": true,
    "lazy": false,
    "noInterop": false,
    "importInterop": "swc",
    "ignoreDynamic": false,
    "preserveImportMeta": false,
    "resolveFully": false
  },
  "jsc": {
    "baseUrl": "./",
    "target": "esnext",
    "loose": false,
    "externalHelpers": true,
    "keepClassNames": false,
    "preserveAllComments": false,
    "paths": {},
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "minify": {
      "compress": {
        "ecma": 2022,
        "arguments": false,
        "arrows": true,
        "booleans": true,
        "collapse_vars": true,
        "comparisons": true,
        "conditionals": true,
        "dead_code": true,
        "directives": true,
        "drop_console": true,
        "drop_debugger": true,
        "evaluate": true,
        "if_return": true,
        "join_vars": true,
        "loops": true,
        "negate_iife": true,
        "passes": 2,
        "reduce_vars": true,
        "sequences": true,
        "switches": true,
        "toplevel": true,
        "typeofs": true,
        "unused": true
      },
      "mangle": {
        "topLevel": true,
        "keepClassNames": false,
        "keepFnNames": false,
        "safari10": false
      },
      "format": {
        "comments": false,
        "asciiOnly": true
      }
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false,
      "react": {
        "runtime": "automatic",
        "importSource": "@emotion/react",
        "useBuiltins": true,
        "refresh": false
      },
      "optimizer": {
        "simplify": true,
        "globals": {
          "vars": {
            "process.env.NODE_ENV": "\"production\""
          },
          "typeofs": {
            "window": "object"
          }
        },
        "jsonify": {
          "minCost": 1024
        }
      }
    },
    "output": {
      "charset": "utf8"
    }
  }
}
