{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
			"@type/*": ["src/assets/type/domain/*"],
      "@assets/*": ["src/assets/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@hooks/*": ["src/hooks/*"],
      "@stores/*": ["src/stores/*"],
      "@pages/*": ["src/pages/*"],
      "@schemas/*": ["src/schemas/*"],
      "@exportHooks": ["src/exports/ExportHooks"],
      "@exportStores": ["src/exports/ExportStores"],
      "@exportLibs": ["src/exports/ExportLibs"],
      "@exportMuis": ["src/exports/ExportMuis"],
      "@exportReacts": ["src/exports/ExportReacts"],
      "@exportSchemas": ["src/exports/ExportSchemas"],
      "@exportScripts": ["src/exports/ExportScripts"],
      "@exportTypes": ["src/exports/ExportTypes"],
      "@exportComponents": ["src/exports/ExportComponents"],
      "@exportContainers": ["src/exports/ExportContainers"],
      "@exportLayouts": ["src/exports/ExportLayouts"],
      "@exportPages": ["src/exports/ExportPages"]
    },
    "typeRoots": [
			"src/assets/type/dist",
			"node_modules/@types"
    ],
		"types": [
			"node"
		]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
    "src/**/*",
    "src/**/*.ts",
		"src/**/*.tsx",
		"eslint.config.js",
		"eslint.config.cjs",
		"eslint.config.mjs",
		"eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}