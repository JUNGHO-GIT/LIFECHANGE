{
  "files.exclude": {
		"**/.git": false,
		"**/.svn": false,
		"**/.hg": false,
		"**/.DS_Store": false,
		"**/Thumbs.db": false,
		"**/CVS": false,
		"**/bower_components": false,
		"**/coverage": false,
		"**/tmp": false,
		"**/.mvn": false,
		"**/mvnw": false,
		"**/mvnw.cmd": false,
		"**/*history*": false,
		"**/*bookmark*": false,
		"**/node_modules": false,
		"**/build": false,
		"**/target": false,
		"**/*.conf": false,
		"**/*.txt": false,
		"**/*.env*": false
	},
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.svn": true,
    "**/bower_components": true,
    "**/build": true,
    "**/target": true,
    "**/*.conf": true,
    "**/*.txt": true,
    "**/*gcloud*": true,
    "**/*.env*": true,
  },
	"eslint.useFlatConfig": true,
	"eslint.workingDirectories": [
		{
			"directory": ".",
			"changeProcessCWD": true
		},
		{
			"directory": "./client",
			"changeProcessCWD": true
		}
	],
	"editor.tabSize": 2,
	"explorerExclude.backup": {},
}