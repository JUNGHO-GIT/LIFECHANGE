{
  "files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/CVS": true,
		"**/bower_components": true,
		"**/coverage": true,
		"**/tmp": true,
		"**/.mvn": true,
		"**/mvnw": true,
		"**/mvnw.cmd": true,
		"**/*history*": true,
		"**/*bookmark*": true,
		"**/node_modules": true,
		"**/build": true,
		"**/target": true,
		"**/*.conf": true,
		"**/*.txt": true
	},
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.svn": true,
    "**/bower_components": true,
    "**/build": true,
    "**/target": true,
    "**/*.conf": true,
    "**/*.txt": true,
    "**/*gcloud*": true,
  },
	"eslint.useFlatConfig": true,
	"eslint.workingDirectories": [
		{
			"directory": ".",
			"changeProcessCWD": true
		},
		{
			"directory": "./client",
			"changeProcessCWD": true
		}
	],
	"editor.tabSize": 2,
	"explorerExclude.backup": {},
}