{
  "$schema": "https://swc.rs/schema.json",
  "isModule": "unknown",
  "sourceMaps": true,
  "inlineSourcesContent": true,
  "exclude": [
    "node_modules"
  ],
  "module": {
    "type": "commonjs",
    "strict": true,
    "strictMode": true,
    "lazy": false,
    "noInterop": false,
    "importInterop": "swc",
    "ignoreDynamic": false,
    "preserveImportMeta": false,
    "resolveFully": false
  },
  "jsc": {
    "baseUrl": "./",
    "target": "esnext",
    "loose": false,
    "externalHelpers": true,
    "keepClassNames": true,
    "preserveAllComments": false,
    "paths": {},
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "minify": {
      "compress": {
        "ecma": 2021,
        "dead_code": true,
        "drop_console": false,
        "drop_debugger": true,
        "unused": true
      },
      "mangle": {
        "keepClassNames": true,
        "keepFnNames": true
      },
      "format": {
        "comments": "some"
      }
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "output": {
      "charset": "utf8"
    }
  }
}
