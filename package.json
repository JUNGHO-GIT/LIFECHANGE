{
  "name": "lifechange-server",
  "version": "2.0.7",
  "type": "module",
  "main": "index.ts",
  "license": "Apache-2.0",
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "import/extensions": "off",
      "import/prefer-default-export": "off",
      "no-console": "off",
      "no-underscore-dangle": "off",
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "react-hooks/rules-of-hooks": "warn",
      "@typescript-eslint/no-unused-vars": [
        "off",
        {
          "varsIgnorePattern": "_",
          "argsIgnorePattern": "_"
        }
      ],
      "@typescript-eslint/no-unused-expressions": "off"
    }
  },
  "engines": {
    "node": "16.x"
  },
  "overrides": {
    "webidl-conversions": "6.1.0",
    "whatwg-url": "12.0.1"
  },
  "scripts": {
    "project": "bun .node/bootstrap-sync.mjs --project",
    "git": "bun .node/bootstrap-sync.mjs --git",
    "ps1": "bun .node/bootstrap-sync.mjs --ps1",
    "tools": "bun .node/bootstrap-sync.mjs --tools",
    "sync": "bun .node/bootstrap-sync.mjs --sync"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-keywords": "5.1.0",
    "axios": "1.13.5",
    "bcryptjs": "3.0.3",
    "body-parser": "2.2.2",
    "cors": "2.8.6",
    "date-fns": "4.1.0",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "google-auth-library": "10.5.0",
    "jsonwebtoken": "9.0.3",
    "module-alias": "2.3.4",
    "moment-timezone": "0.6.0",
    "mongodb": "7.1.0",
    "mongoose": "9.1.6",
    "node-fetch": "3.3.2",
    "nodemailer": "8.0.4",
    "oauth-signature": "1.5.0",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "qs": "6.14.2",
    "request": "2.88.2",
    "request-promise": "4.2.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.7.1",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.11",
    "@swc/helpers": "0.5.18",
    "@types/cors": "2.8.19",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.1",
    "@types/express-session": "1.18.2",
    "@types/jsdom": "27.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "25.2.1",
    "@types/nodemailer": "7.0.9",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/qs": "6.14.0",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "esbuild": "0.27.3",
    "eslint": "10.0.0",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.3.0",
    "jsdom": "28.0.0",
    "ts-morph": "27.0.2",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
